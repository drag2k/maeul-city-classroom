{
  "framework": null,
  "buildCommand": "node build.mjs --vercel",
  "outputDirectory": "public-build",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "regions": [
    "icn1"
  ]
}
